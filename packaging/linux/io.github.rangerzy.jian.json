{
  "app-id": "io.github.rangerzy.jian",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.12-beta",
  "sdk": "org.kde.Sdk",
  "branch": "stable",
  "command": "jian",
  "appstream-compose": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "jian",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=OFF"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build",
            "dist"
          ]
        }
      ]
    }
  ]
}
